# Create one at: https://expo.dev/
EXPO_TOKEN=your-expo-access-token-here

# WeatherAI API key. Free key at https://weather-ai.co (dashboard > API Keys).

EXPO_PUBLIC_WEATHERAI_KEY=wai_live_your_key_here

# WeatherAI base URL (from the docs).
EXPO_PUBLIC_WEATHERAI_BASE_URL=https://api.weather-ai.co
